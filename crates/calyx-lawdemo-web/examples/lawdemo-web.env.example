# ---------------------------------------------------------------------------
# calyx-lawdemo-web — DEVELOPMENT-SAMPLE environment
#
# This wires the service against the checked-in development-sample evidence
# (crates/calyx-lawdemo-web/examples/evidence). It lets the Research Console and
# the JSON API be run and tested OFFLINE with no resident and no CUDA. It is NOT a
# production config: the sample dir is excluded from production serving. Production
# points LAWDEMO_WEB_EVIDENCE_DIR at the real FSV evidence and re-pins the SHA to
# the accepted census artifact (see docs/lawsearch/26_demo_frontend.md).
#
# Usage (from the repo root):
#   set -a; . crates/calyx-lawdemo-web/examples/lawdemo-web.env.example; set +a
#   cargo run -p calyx-lawdemo-web
# then browse http://127.0.0.1:8600 (or /console — same page). Chat stays disabled
# until LAWDEMO_WEB_CHAT_ENABLED=1 + the DeepSeek vars are set; the console still
# serves and the corpus-census artifact still loads from the sample evidence.
# ---------------------------------------------------------------------------

# Bind (loopback only; a non-loopback value is refused at startup).
LAWDEMO_WEB_BIND_ADDR=127.0.0.1:8600

# Live mode — a bogus path so live buttons fail loudly (offline dev). In
# production this is the pinned FSV runtime/calyx and the live resident addr.
LAWDEMO_WEB_CALYX_BINARY=/nonexistent/calyx
LAWDEMO_WEB_RESIDENT_ADDR=127.0.0.1:18401

# CALYX_HOME for every live subprocess (REQUIRED). The pinned binary's vault
# commands (kernel-answer / reproduce / verify-chain / ledger-tail) fail without
# it — "CALYX_CLI_USAGE_ERROR: CALYX_HOME is required for vault commands". It is
# passed EXPLICITLY into each subprocess env, never merely inherited. In
# production this is the FSV CALYX_HOME (e.g. /var/lib/calyx).
LAWDEMO_WEB_CALYX_HOME=/var/lib/calyx

# ORT_DYLIB_PATH for the ONNX Runtime dylib (OPTIONAL). When set it is passed
# through to every live subprocess as ORT_DYLIB_PATH. Per #1951, an UNSET
# ORT_DYLIB_PATH turns a lens-loading failure into an indefinite hang, so a
# deployment that loads lenses live should set it explicitly. Left unset here
# (offline dev never reaches lens loading).
#LAWDEMO_WEB_ORT_DYLIB_PATH=/opt/onnxruntime/lib/libonnxruntime.so

# Vault ids (production + the two scoped demo vaults). Echoed in /api/health.
LAWDEMO_WEB_VAULT=/zfs/hot/calyx/vaults/PRODUCTION_VAULT_ULID
LAWDEMO_WEB_D1_VAULT=/zfs/hot/calyx/vaults/D1_VAULT_ULID
LAWDEMO_WEB_D1_KERNEL=b8f96b5deea45b743229242283234f9e
LAWDEMO_WEB_D2_VAULT=/zfs/hot/calyx/vaults/D2_VAULT_ULID
LAWDEMO_WEB_D2_KERNEL=b38822aad594ab8c521b64683c118f36

# Artifact mode — the development-sample evidence dir + the SHA-256 pin for the
# ONE artifact the console consumes: the demo-4 corpus census (served at
# GET /api/demo/4 as the Corpus/Graph tab fallback). Production points
# LAWDEMO_WEB_EVIDENCE_DIR at the real FSV evidence and re-pins the SHA.
LAWDEMO_WEB_EVIDENCE_DIR=crates/calyx-lawdemo-web/examples/evidence
LAWDEMO_WEB_EVIDENCE_LABEL=development-sample

LAWDEMO_WEB_DEMO4_FILE=demo4_dissent.json
LAWDEMO_WEB_DEMO4_SHA=00e21cbeaa9835cc602b5395efe3bd4d5e6cb981879eed0a94b80e2c78def890

# Timeouts (seconds).
# Every live tool uses one hard budget. Exact kernel ranking is served by the
# generation-pinned resident and never cold-loads the sealed index per request.
LAWDEMO_WEB_LIVE_TIMEOUT_SECS=120
LAWDEMO_WEB_RESIDENT_PROBE_TIMEOUT_SECS=4
# Chat episode wall clock spans several reasoning and tool turns.
LAWDEMO_WEB_CHAT_WALL_TIMEOUT_SECS=300
