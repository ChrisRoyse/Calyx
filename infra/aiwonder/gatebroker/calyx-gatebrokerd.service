[Unit]
Description=Calyx privileged gate transaction and stage broker
Documentation=file:/home/croyse/calyx/repo/docs/implementation/issue1455-1457-calyx-gatebrokerd.md
Requires=calyx-gatebrokerd.socket
After=calyx-gatebrokerd.socket local-fs.target systemd-user-sessions.service
RequiresMountsFor=/home/croyse/calyx /var/lib/calyx-gatebrokerd
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=root
Group=root
UMask=0077
Sockets=calyx-gatebrokerd.socket
ExecStartPre=/usr/libexec/calyx-gatebrokerd verify-config --config /etc/calyx-gatebrokerd/config.toml
ExecStart=/usr/libexec/calyx-gatebrokerd serve --config /etc/calyx-gatebrokerd/config.toml
Restart=on-failure
RestartSec=1s
RestartPreventExitStatus=64 78
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
RuntimeDirectory=calyx-gatebrokerd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=calyx-gatebrokerd
StateDirectoryMode=0711
ConfigurationDirectory=calyx-gatebrokerd
ConfigurationDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=calyx-gatebrokerd

# The broker needs the host system bus and descriptor-relative access to the
# configured roots and cgroup v2. It does not need network or device access.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_KILL
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/calyx-gatebrokerd/config.toml
ReadOnlyPaths=/home/croyse/calyx
ReadWritePaths=/var/lib/calyx-gatebrokerd
ReadWritePaths=/run/calyx-gatebrokerd
ReadWritePaths=/sys/fs/cgroup
InaccessiblePaths=/run/user
ProtectControlGroups=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
